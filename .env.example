# =============================================================================
# ForgeRAG — 环境变量配置模板
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env（放在项目根目录）
#   2. 按实际环境修改各配置项的值
#   3. 应用启动时会通过 pydantic-settings 自动加载 .env 中的值
#
# 注意：本文件包含示例值，请勿将真实的敏感信息（密码、API Key）提交到版本控制。
# =============================================================================


# ---------------------------------------------------------------------------
# 应用基础配置
# ---------------------------------------------------------------------------
APP_NAME=forgerag-api          # 应用名称，用于服务注册、日志标识等
APP_ENV=dev                    # 运行环境：dev / test / staging / production
APP_HOST=0.0.0.0               # 监听地址（0.0.0.0 表示绑定所有网络接口）
APP_PORT=8000                  # HTTP 服务监听端口
LOG_LEVEL=INFO                 # 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL


# ---------------------------------------------------------------------------
# PostgreSQL 关系型数据库
# ---------------------------------------------------------------------------
# 用于存储文档元数据、用户信息、对话历史、知识库结构等结构化数据。
# 确保 PostgreSQL 服务已启动且指定数据库已创建。
POSTGRES_HOST=localhost        # 数据库主机地址
POSTGRES_PORT=5432             # 数据库端口（PostgreSQL 默认 5432）
POSTGRES_DB=forgerag           # 数据库名称（需提前创建）
POSTGRES_USER=forgerag         # 数据库登录用户
POSTGRES_PASSWORD=forgerag_password  # 数据库密码（生产环境请使用强密码）

# 完整的数据库连接 URL（SQLAlchemy + asyncpg 异步驱动）
# 格式：postgresql+asyncpg://<用户>:<密码>@<主机>:<端口>/<数据库>
DATABASE_URL=postgresql+asyncpg://forgerag:forgerag_password@localhost:5432/forgerag


# ---------------------------------------------------------------------------
# Qdrant 向量数据库
# ---------------------------------------------------------------------------
# 用于存储文档切块（Chunks）的向量嵌入，支撑语义相似度检索。
# Qdrant 可以本地运行（Docker），也可以使用 Qdrant Cloud 服务。
QDRANT_HOST=localhost          # Qdrant 服务主机地址
QDRANT_PORT=6333               # gRPC / HTTP 端口（Qdrant 默认 6333）
QDRANT_URL=http://localhost:6333  # Qdrant HTTP 接口完整 URL
QDRANT_COLLECTION=forgerag_chunks  # 向量集合名称（类似关系数据库中的"表"）


# ---------------------------------------------------------------------------
# 本地文件存储
# ---------------------------------------------------------------------------
UPLOAD_DIR=storage/uploads     # 文件上传的本地存储路径（相对于项目根目录）
MAX_UPLOAD_SIZE_MB=20          # 单次上传文件的最大体积（单位：MB）


# ---------------------------------------------------------------------------
# LLM（大语言模型）配置
# ---------------------------------------------------------------------------
# 用于 RAG 流程中的答案生成、查询重写、Agent 推理等任务。
# 支持任何兼容 OpenAI API 格式的服务（OpenAI、Azure OpenAI、Ollama、vLLM 等）。
LLM_PROVIDER=openai_compatible # 模型提供商类型：openai / openai_compatible / azure / ollama 等
LLM_API_BASE=                  # API 端点地址（如 https://api.openai.com/v1 或 http://localhost:11434/v1）
LLM_API_KEY=                   # API 密钥（OpenAI 格式；Ollama 本地部署可留空）
LLM_MODEL=                     # 模型名称（如 gpt-4o、qwen2.5:7b、deepseek-chat 等）


# ---------------------------------------------------------------------------
# Embedding（文本嵌入）模型配置
# ---------------------------------------------------------------------------
# 将文档与用户查询转化为向量，用于语义相似度匹配。
# 可与 LLM 使用不同提供商（例如 LLM 用 OpenAI，Embedding 用本地模型）。
EMBEDDING_PROVIDER=openai_compatible  # 嵌入模型提供商
EMBEDDING_API_BASE=                   # 嵌入服务 API 端点
EMBEDDING_API_KEY=                    # 嵌入服务 API 密钥
EMBEDDING_MODEL=                      # 嵌入模型名称（如 text-embedding-3-small、bge-m3 等）
EMBEDDING_DIM=                        # 嵌入向量维度（如 1536、1024、768；设为空则由模型自动决定）


# ---------------------------------------------------------------------------
# Rerank（重排序）模型配置
# ---------------------------------------------------------------------------
# 在向量检索后，对召回结果做二次排序，提升最终结果的精准度。
# 可选组件：不启用则直接使用向量检索的原始排序结果。
RERANK_ENABLED=false           # 是否启用重排序（true / false）
RERANK_PROVIDER=               # 重排序服务提供商（如 cohere、jina、bge-reranker 等）
RERANK_API_BASE=               # 重排序服务 API 端点
RERANK_API_KEY=                # 重排序服务 API 密钥
RERANK_MODEL=                  # 重排序模型名称


# ---------------------------------------------------------------------------
# Langfuse — LLM 可观测性与 Trace 追踪
# ---------------------------------------------------------------------------
# 记录每一次 LLM 调用的输入、输出、耗时、Token 消耗，用于调试、评估与审计。
# 可自托管（开源）或使用 Langfuse Cloud 服务。
LANGFUSE_ENABLED=false         # 是否启用 Langfuse 追踪（true / false）
LANGFUSE_BASE_URL=http://localhost:3000  # Langfuse 服务地址（自托管时默认 3000 端口）
LANGFUSE_PUBLIC_KEY=           # Langfuse 公钥（相当于用户名，用于鉴权）
LANGFUSE_SECRET_KEY=           # Langfuse 密钥（相当于密码，请妥善保管）
LANGFUSE_ENVIRONMENT=dev       # Langfuse 内部的环境标签，用于区分不同部署环境的数据


# ---------------------------------------------------------------------------
# 可观测性通用配置
# ---------------------------------------------------------------------------
OBSERVABILITY_SAMPLE_RATE=1.0  # 链路追踪的采样率（0.0 ~ 1.0）
                               # 1.0 表示 100% 采样（开发调试时）；
                               # 生产环境可调低（如 0.1）以减少性能开销
